# 统一换行符：仓库内一律 LF，Windows 脚本保持 CRLF
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.7z binary
*.rar binary
*.docx binary
*.xlsx binary
*.mp4 binary
*.tif binary
*.tiff binary
*.shp binary
*.shx binary
*.dbf binary

# GitHub Linguist：统计语言时忽略生成物与第三方代码
package-lock.json linguist-generated=true
*.min.js linguist-generated=true
*.min.css linguist-generated=true
