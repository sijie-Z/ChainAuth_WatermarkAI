# ============================================
# 苏州园林数字资产平台 — 环境变量配置
# Suzhou Garden Digital Asset Platform
# ============================================
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ============================================
# 1. 应用基础配置 (Application)
# ============================================
FLASK_APP=run.py
# 运行环境: development | production | testing
FLASK_ENV=development
# 应用密钥 — 生产环境必须替换：python scripts/generate_secrets.py
# 生产启动会拒绝 change-me 占位文本与不足 32 位的密钥
SECRET_KEY=change-me-to-a-random-secret-key
# JWT 签名密钥 — 生产环境必须替换
JWT_SECRET_KEY=change-me-to-a-random-jwt-key
# JWT 令牌过期时间 (秒), 默认 24 小时
# JWT_ACCESS_TOKEN_EXPIRES=86400
# JWT 刷新令牌过期时间 (秒), 默认 30 天
# JWT_REFRESH_TOKEN_EXPIRES=2592000
# 初始化脚本创建 admin 时使用的密码（生产未设置时随机生成并打印一次；开发默认 admin123）
# ADMIN_INITIAL_PASSWORD=
# 生产环境是否创建 adm1/adm2/user1/user2 演示账号（默认 false，仅演示部署开启）
# SEED_DEMO_USERS=false
# 仅在后端不直接对外暴露（只经 nginx 反代）时开启，否则可伪造 X-Forwarded-For
# TRUST_PROXY_HEADERS=false

# ============================================
# 2. 数据库 (Database)
# ============================================
# PostgreSQL (推荐生产环境)
# DATABASE_URL=postgresql://user:password@localhost:5432/garden_asset
# MySQL
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/garden_asset
# SQLite (默认，适合开发/测试)
DATABASE_URL=sqlite:///garden_asset.db

# ============================================
# 3. Redis (缓存) [可选]
# ============================================
# 不设 Redis 时使用内存缓存
REDIS_URL=redis://localhost:6379/0

# ============================================
# 4. MinIO (对象存储) [可选]
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=garden-assets
# 是否使用 HTTPS 连接 MinIO
MINIO_SECURE=false

# ============================================
# 5. 区块链 — FISCO BCOS (Blockchain)
# ============================================
# 是否启用区块链功能
BLOCKCHAIN_ENABLED=false
# FISCO BCOS 节点 RPC 地址
BLOCKCHAIN_RPC_URL=http://localhost:20200
# 已部署的合约地址（部署后填写）
CONTRACT_ADDRESS=
# 链 ID
CHAIN_ID=1
# 用于签名的私钥（部署时生成）
PRIVATE_KEY=

# ============================================
# 6. AI 服务 (Artificial Intelligence)
# ============================================
# 是否启用 AI 功能
AI_ENABLED=true
# 智谱 AI (GLM-4-Flash) — https://open.bigmodel.cn
ZHIPU_API_KEY=your-zhipu-api-key-here
# Milvus 向量数据库存储路径
MILVUS_DB_PATH=./data/milvus.db

# ============================================
# 7. 百度 OCR (文字识别) [可选]
# ============================================
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ============================================
# 8. 文件存储路径 (Storage)
# ============================================
UPLOAD_FOLDER=./uploads
WATERMARK_FOLDER=./watermarks
EXTRACTED_FOLDER=./extracted
# 数据库备份目录（Docker 中为 /app/backups 挂载卷）
BACKUP_DIR=./backups

# ============================================
# 9. 安全配置 (Security)
# ============================================
# 允许的最大文件上传大小（字节，默认 500MB）
MAX_CONTENT_LENGTH=524288000
# 匿名溯源接口单文件上限（字节，默认 20MB）
TRACE_MAX_CONTENT_LENGTH=20971520
# 矢量压缩包解压后总大小上限（字节，默认 200MB）
VECTOR_EXTRACT_MAX_BYTES=209715200
# 允许的跨域来源 (CORS)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 请求速率限制（次数 / 窗口秒数），必须是整数
RATELIMIT_ENABLED=true
RATELIMIT_LOGIN=5
RATELIMIT_LOGIN_WINDOW=60
RATELIMIT_REGISTER=3
RATELIMIT_REGISTER_WINDOW=3600
RATELIMIT_API=100
RATELIMIT_API_WINDOW=60
# 多 worker 部署时保持 false，避免备份/过期任务重复执行
SCHEDULER_ENABLED=false

# 异步任务队列（水印/存证）
# 生产建议 false，由 docker compose worker 或 `flask tasks run` 独立执行；
# 本地开发不设置时 development 配置默认启用进程内 worker。
TASK_WORKER_ENABLED=false
TASK_MAX_ATTEMPTS=3
TASK_STUCK_TIMEOUT_MINUTES=15
TASK_WORKER_POLL_INTERVAL=1.0
# worker 心跳超过该秒数未刷新视为离线；排队数达到阈值时健康度降为 warning
TASK_WORKER_STALE_SECONDS=90
TASK_BACKLOG_THRESHOLD=50

# 站内实时通知（SSE）
SSE_ENABLED=true
SSE_MAX_SECONDS=300
SSE_POLL_INTERVAL=5
SSE_MAX_CONNECTIONS_PER_USER=3

# 邮件通知（可选；配置后用户可在账号设置中开启）
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
PUBLIC_BASE_URL=http://localhost:5173
# Webhook 默认拒绝内网/回环地址（SSRF 防护）；内部自动化可显式开启
WEBHOOK_ALLOW_PRIVATE=false

# ============================================
# 10. 日志配置 (Logging)
# ============================================
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志输出目录
LOG_FOLDER=./logs
# 日志轮转文件数
LOG_BACKUP_COUNT=10
# 单个日志文件最大大小 (Bytes)
LOG_MAX_BYTES=10485760

# ============================================
# 11. 邮件服务 (Email) [可选]
# ============================================
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
