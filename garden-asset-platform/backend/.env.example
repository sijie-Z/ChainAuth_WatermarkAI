# ============================================
# 苏州园林数字资产平台 — 环境变量配置
# Suzhou Garden Digital Asset Platform
# ============================================
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# ============================================
# 1. 应用基础配置 (Application)
# ============================================
FLASK_APP=run.py
# 运行环境: development | production | testing
FLASK_ENV=development
# 应用密钥 — 生产环境务必修改为随机字符串
SECRET_KEY=change-me-to-a-random-secret-key
# JWT 签名密钥 — 生产环境务必修改
JWT_SECRET_KEY=change-me-to-a-random-jwt-key
# JWT 令牌过期时间 (秒), 默认 24 小时
# JWT_ACCESS_TOKEN_EXPIRES=86400
# JWT 刷新令牌过期时间 (秒), 默认 30 天
# JWT_REFRESH_TOKEN_EXPIRES=2592000

# ============================================
# 2. 数据库 (Database)
# ============================================
# PostgreSQL (推荐生产环境)
# DATABASE_URL=postgresql://user:password@localhost:5432/garden_asset
# MySQL
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/garden_asset
# SQLite (默认，适合开发/测试)
DATABASE_URL=sqlite:///garden_asset.db

# ============================================
# 3. Redis (缓存) [可选]
# ============================================
# 不设 Redis 时使用内存缓存
REDIS_URL=redis://localhost:6379/0

# ============================================
# 4. MinIO (对象存储) [可选]
# ============================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=garden-assets
# 是否使用 HTTPS 连接 MinIO
MINIO_SECURE=false

# ============================================
# 5. 区块链 — FISCO BCOS (Blockchain)
# ============================================
# 是否启用区块链功能
BLOCKCHAIN_ENABLED=false
# FISCO BCOS 节点 RPC 地址
BLOCKCHAIN_RPC_URL=http://localhost:20200
# 已部署的合约地址（部署后填写）
CONTRACT_ADDRESS=
# 链 ID
CHAIN_ID=1
# 用于签名的私钥（部署时生成）
PRIVATE_KEY=

# ============================================
# 6. AI 服务 (Artificial Intelligence)
# ============================================
# 是否启用 AI 功能
AI_ENABLED=true
# 智谱 AI (GLM-4-Flash) — https://open.bigmodel.cn
ZHIPU_API_KEY=your-zhipu-api-key-here
# Milvus 向量数据库存储路径
MILVUS_DB_PATH=./data/milvus.db

# ============================================
# 7. 百度 OCR (文字识别) [可选]
# ============================================
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# ============================================
# 8. 文件存储路径 (Storage)
# ============================================
UPLOAD_FOLDER=./uploads
WATERMARK_FOLDER=./watermarks
EXTRACTED_FOLDER=./extracted

# ============================================
# 9. 安全配置 (Security)
# ============================================
# 允许的最大文件上传大小（字节，默认 500MB）
MAX_CONTENT_LENGTH=524288000
# 匿名溯源接口单文件上限（字节，默认 20MB）
TRACE_MAX_CONTENT_LENGTH=20971520
# 矢量压缩包解压后总大小上限（字节，默认 200MB）
VECTOR_EXTRACT_MAX_BYTES=209715200
# 允许的跨域来源 (CORS)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 请求速率限制（次数 / 窗口秒数），必须是整数
RATELIMIT_ENABLED=true
RATELIMIT_LOGIN=5
RATELIMIT_LOGIN_WINDOW=60
RATELIMIT_REGISTER=3
RATELIMIT_REGISTER_WINDOW=3600
RATELIMIT_API=100
RATELIMIT_API_WINDOW=60
# 多 worker 部署时保持 false，避免备份/过期任务重复执行
SCHEDULER_ENABLED=false

# ============================================
# 10. 日志配置 (Logging)
# ============================================
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# 日志输出目录
LOG_FOLDER=./logs
# 日志轮转文件数
LOG_BACKUP_COUNT=10
# 单个日志文件最大大小 (Bytes)
LOG_MAX_BYTES=10485760

# ============================================
# 11. 邮件服务 (Email) [可选]
# ============================================
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
