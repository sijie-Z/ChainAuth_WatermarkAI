# Docker Compose 环境变量
# 复制此文件为 .env 并填入实际值

# Flask 密钥（必填）：运行 python backend/scripts/generate_secrets.py 生成
# 生产启动会拒绝 change-me 占位文本与不足 32 位的密钥
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-another-random-secret

# 生产初始化时是否创建 adm1/adm2/user1/user2 演示账号（弱口令，默认 false）
# SEED_DEMO_USERS=false

# PostgreSQL 配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=garden_asset

# MinIO 配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
