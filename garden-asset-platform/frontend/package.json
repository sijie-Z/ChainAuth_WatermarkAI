    "echarts": "^5.4.3",
    "three": "^0.160.0",
    "@element-plus/icons-vue": "^2.3.1",
    "dayjs": "^1.11.10",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "qs": "^6.11.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "vite": "^5.0.10",
    "sass": "^1.69.5",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.1.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "unplugin-auto-import": "^0.17.3",
    "unplugin-vue-components": "^0.26.0",
    "terser": "^5.24.0"
  },
  "engines": {
