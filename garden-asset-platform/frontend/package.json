{
  "name": "garden-asset-frontend",
  "version": "1.12.1",
  "description": "苏州园林数字资产安全分发与溯源系统前端",
  "author": "苏州园林数字资产平台团队",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "lint:check": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests --maxWorkers=1 --pool=vmThreads",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "test:ci:safe": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.2",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "lodash-es": "^4.17.21",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "qs": "^6.11.2",
    "three": "^0.186.1",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "terser": "^5.51.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "test-exclude": {
      "glob": "10.5.0"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
